# Copie este arquivo para .env e preencha com os SEUS dados.
# O .env guarda segredos e nunca deve ser compartilhado nem enviado ao Git.

# ── Telegram (obrigatório) ───────────────────────────────────────────
# Token do bot, criado no @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Canais/grupos onde publicar, separados por vírgula.
# Canal público: @nomedocanal | privado: id numérico (ex: -1001234567890)
TELEGRAM_CHAT_IDS=
# Seu user id (mande /id para o bot). Só você comanda o bot.
TELEGRAM_OWNER_ID=

# ── Mercado Livre ────────────────────────────────────────────────────
# "Etiqueta em uso" do Linkbuilder (mercadolivre.com.br/afiliados/linkbuilder)
ML_ETIQUETA=

# ── Amazon ───────────────────────────────────────────────────────────
# Sua tag do Amazon Associados (ex: seunome-20)
AMAZON_TAG=
# Creators API (opcional; sem isso a Amazon usa scraping de reserva)
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=

# ── Shopee ───────────────────────────────────────────────────────────
# Painel de afiliados Shopee > Open API
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# ── Inteligência Artificial (opcional) ───────────────────────────────
# Chave da API da Anthropic (console.anthropic.com). Sem ela, o bot usa
# chamadas prontas em vez de chamadas criadas por IA.
ANTHROPIC_API_KEY=
